# File streaming: avoids holding the entire statement in memory
def write_statement(path, parts):
    with open(path, "w", encoding="utf-8") as f:
        for p in parts:
            f.write(p)
            f.write(";")
# StringIO: convenient file-like in-memory builder
from io import StringIO
def build_stringio(parts):
    out = StringIO()
    for p in parts:
        out.write(p)
        out.write(";")
    return out.getvalue()
join() needs memory for the list of parts plus the final string. StringIO stores the built content in memory and returns a final
string when requested. Writing directly to a file uses much less peak memory for the final text, but the result is on disk
rather than returned as one in-memory string. All methods require O(n) output work when implemented efficiently;
repeated += can be O(n²) in the worst case.
