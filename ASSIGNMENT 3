def merge_contacts(contact_lists):
    merged = {}
    for contacts in contact_lists:
        for contact in contacts:
            key = normalise_phone(contact.get("phone", ""))
            if not key:
                continue
            group = merged.setdefault(key, {
                "normalised_phone": key,
                "names": set(), "phones": set(), "emails": set()
            })
            name = contact.get("name", "").strip()
            phone = contact.get("phone", "").strip()
            email = contact.get("email", "").strip().lower()
            if name:
                group["names"].add(name)
            if phone:
                group["phones"].add(phone)
            if email:
                group["emails"].add(email)
    return merged
