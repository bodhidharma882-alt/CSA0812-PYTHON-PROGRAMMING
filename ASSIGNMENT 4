from pathlib import Path
from datetime import datetime
def save_returns(books, log_path="returns.log"):
    with open(log_path, "a", encoding="utf-8") as log:
        for book in books:
            if book.strip():
                log.write(book.rstrip() + "\\n")
def process(day_file, log_path="returns.log",
            error_path="errors.log"):
    try:
        with open(day_file, "r", encoding="utf-8") as source:
            books = source.read().splitlines()
        save_returns(books, log_path)
    except (FileNotFoundError, PermissionError,
            UnicodeDecodeError, OSError) as exc:
        with open(error_path, "a", encoding="utf-8") as errors:
            errors.write(
                f"{datetime.now().isoformat()} | "
                f"{day_file} | {type(exc).__name__}: {exc}\\n")
4.4 Prevention rules
• Use append mode ('a') for cumulative logs; use write mode ('w') only when intentionally creating a fresh report.
• Use with statements for every file and write explicit newline characters between records. Log failures with enough
context to diagnose them.
