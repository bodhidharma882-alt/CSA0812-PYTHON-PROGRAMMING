3.3 Complete try statement and completed code
import os
import tempfile
class InvalidRecord(Exception):
    """Raised when a line is not in the expected format."""
def parse_line(line):
    parts = line.strip().split(",")
    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}")
    reg_no, date_text, status = (part.strip() for part in parts)
    if status not in ("P", "A"):
        raise InvalidRecord(f"invalid status '{status}'")
    if not reg_no or not date_text:
        raise InvalidRecord("register number/date is empty")
    return reg_no, date_text, status
def summarise(path):
    present, absent, errors = 0, 0, []
    try:
        with open(path, "r", encoding="utf-8") as file:
            for line_number, line in enumerate(file, start=1):
                if not line.strip():
                    continue
                try:
                    _reg_no, _date, status = parse_line(line)
                except InvalidRecord as exc:
                    errors.append((line_number, str(exc)))
                    continue
                else:
                    if status == "P":
                        present += 1
                    else:
                        absent += 1
    except (FileNotFoundError, PermissionError, UnicodeDecodeError) as exc:
        raise RuntimeError(f"Cannot process {path}") from exc
    finally:
        # The with statement closes an opened file automatically.
        pass
    return present, absent, errors
