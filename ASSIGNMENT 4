# main.py – self-contained demonstration of the package logic
from pathlib import Path
import csv
class InvalidRecord(Exception):
    pass
def valid_email(email):
    if email.count("@") != 1:
        return False
    local, domain = email.split("@")
    return (bool(local) and bool(domain) and "." in domain
            and not domain.startswith(".")
            and not domain.endswith(".")
            and " " not in email)
def parse_record(line):
    fields = [x.strip() for x in line.strip().split(",")]
    if len(fields) != 5:
        raise InvalidRecord("expected 5 comma-separated fields")
    reg, name, dept, email, event_text = fields
    if not all((reg, name, dept, email, event_text)):
        raise InvalidRecord("one or more required fields are empty")
    if not valid_email(email):
        raise InvalidRecord(f"invalid email '{email}'")
    events = [e.strip() for e in event_text.split(";") if e.strip()]
    if not events:
        raise InvalidRecord("no valid events selected")
    return {"reg": reg, "name": name, "dept": dept,
            "email": email, "events": events}
